# Django Settings
SECRET_KEY=merugu-super-secret-key-change-in-production-ai-bpo-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL default, falls back to SQLite if not provided)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=merugu_bpo_db
DB_USER=merugu_user
DB_PASSWORD=merugu_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Email Integration (SMTP Fallback)
DEFAULT_FROM_EMAIL=bpo@meruguglobal.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Google OAuth (Gmail Integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# Microsoft OAuth (Outlook Integration)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Rate Limits & Compliance
MAX_DAILY_EMAIL_SEND_LIMIT=150
CRAWLER_DELAY_SECONDS=1.0
USER_AGENT_STRING=MeruguBPOBot/1.0 (+https://meruguglobal.com/bot-info)
